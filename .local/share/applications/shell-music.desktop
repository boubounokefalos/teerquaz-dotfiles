[Desktop Entry]
Type=Application
Name=Music
Comment=Play the songs in your Music folder
Icon=multimedia-audio-player
Exec=sh -c "\\"\\$HOME/.config/quickshell/scripts/music-open.sh\\" \\"\\$@\\"" sh %F
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/mp4;audio/x-m4a;audio/aac;audio/x-wav;audio/x-flac;
Categories=AudioVideo;Audio;Player;
Keywords=mpv;songs;player;
OnlyShowIn=Hyprland;
