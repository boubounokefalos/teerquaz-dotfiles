// fastfetch — Teerquaz (slate turquoise). Colours are the terminal's own
// palette slots (ANSI codes), so they follow Ghostty's theme and still work on
// a TTY: 36 cyan #2ec4b6 · 96 bright cyan #64dfdf · 90 grey #5c6a72.
// ~/.bashrc runs this through `fetch`, which swaps in the smooth image logo
// (arch.png) on Ghostty/kitty, drops the logo in narrow windows and splits,
// skips tiny ones and uses text keys on the Linux console.
// Logos made from /usr/share/pixmaps/archlinux-logo.svg.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/arch.txt",
    "color": { "1": "36" },
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "36", "title": "96", "output": "37" },
    "key": { "type": "icon", "width": 4 },
    "percent": { "type": ["num", "num-color"], "green": 70, "yellow": 90, "color": { "green": "36", "yellow": "33", "red": "31" } },
    "size": { "binaryPrefix": "iec", "ndigits": 1 },
    "disableLinewrap": true
  },
  "modules": [
    { "type": "title", "format": "{#1;96}{user-name}{#90}@{#1;36}{host-name}" },
    { "type": "custom", "format": "{#90}────────────────────────────" },
    { "type": "os",       "key": "os",     "keyIcon": "󰣇", "format": "{pretty-name}" },
    { "type": "kernel",   "key": "kernel", "keyIcon": "󰌽", "format": "{release}" },
    { "type": "uptime",   "key": "uptime", "keyIcon": "󰔟" },
    { "type": "packages", "key": "pkgs",   "keyIcon": "󰏖" },
    { "type": "wm",       "key": "wm",     "keyIcon": "󰖯", "format": "{pretty-name} {version}" },
    { "type": "cpu",      "key": "cpu",    "keyIcon": "󰻠", "format": "{name} ({cores-logical})" },
    { "type": "gpu",      "key": "gpu",    "keyIcon": "󰢮", "format": "{name}" },
    { "type": "memory",   "key": "memory", "keyIcon": "󰍛", "format": "{used} / {total}  {percentage}" },
    { "type": "disk",     "key": "disk",   "keyIcon": "󰋊", "folders": "/", "format": "{size-used} / {size-total}  {size-percentage}" },
    // laptops only: prints nothing where there is no battery
    { "type": "battery",  "key": "battery", "keyIcon": "󰁹", "format": "{capacity}  {status}", "percent": { "type": ["num"] } }
  ]
}
